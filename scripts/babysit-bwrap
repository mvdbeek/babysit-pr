#!/usr/bin/env bash
# Linux agent sandbox: bubblewrap behind Agent Safehouse's grant options.
#
#   babysit-bwrap [--add-dirs=A:B] [--claude-config-dir=D | --codex-home=D]
#                 [--env-pass=X,Y] [--enable=docker,playwright,gpg] [--print-argv] [--] command...
#
# Deny by default: a read-only system, an empty $HOME, and writes only to --add-dirs (the
# caller passes the worktree and its git common directory there), the one agent
# configuration directory (which must exist; what it runs code from stays read-only) and
# a cache root that only sandboxed agents of that configuration and grants use. Nothing
# is discovered from the working directory or its git files, which the agent can rewrite.
# Every writable path must be absolute and is resolved first; home, its ancestors and
# protected paths are refused. The environment is cleared except for a small baseline,
# the agent configuration variable, the cache variables and the --env-pass names that
# are set. The network is shared. --enable=gpg lets git sign through this user's
# gpg-agent without exposing ~/.gnupg (see below). Where bwrap has --bind-fd (0.10.0
# and later), each writable directory is opened once, checked through its descriptor and bound by it, so
# a path swapped after the check cannot redirect the bind. --print-argv prints the bwrap
# argv, NUL-separated, instead of running it. Needs bash 4.1 or later (`exec {fd}<`).
set -euo pipefail

die() {
  printf 'babysit-bwrap: %s\n' "$*" >&2
  exit 2
}

add_dirs=()
env_pass=()
config_var=
config_dir=
docker=0
gpg=0
print=0
tiocsti=/proc/sys/dev/tty/legacy_tiocsti
while (($#)); do
  option=$1
  case $option in
    --add-dirs | --env-pass | --enable | --claude-config-dir | --codex-home)
      (($# > 1)) || die "$option needs a value"
      shift
      option="$option=$1"
      ;;
  esac
  # `read` stops at a newline, which would silently drop the rest of a list.
  [[ $option != *$'\n'* ]] || die "refusing an option containing a newline"
  case $option in
    --add-dirs=*) IFS=: read -r -a more <<<"${option#*=}" && add_dirs+=(${more[@]+"${more[@]}"}) ;;
    --env-pass=*) IFS=, read -r -a more <<<"${option#*=}" && env_pass+=(${more[@]+"${more[@]}"}) ;;
    --claude-config-dir=* | --codex-home=*)
      [[ -z $config_var ]] || die "only one agent configuration directory is allowed"
      config_var=CLAUDE_CONFIG_DIR
      [[ $option == --claude-config-dir=* ]] || config_var=CODEX_HOME
      config_dir=${option#*=}
      ;;
    --enable=*)
      IFS=, read -r -a more <<<"${option#*=}"
      for feature in ${more[@]+"${more[@]}"}; do
        case $feature in
          docker) docker=1 ;;
          gpg) gpg=1 ;;
          # Accepted like Safehouse's playwright-chrome: Chromium needs nothing beyond
          # the always-present /dev/shm and the sandbox's own browser cache.
          playwright | playwright-chrome) ;;
          *) die "unknown feature $feature" ;;
        esac
      done
      ;;
    --print-argv) print=1 ;;
    # Test hook for the TIOCSTI check below; honoured only by a dry run.
    --tiocsti-sysctl=*) tiocsti=${option#*=} && fake_tiocsti=1 ;;
    --)
      shift
      break
      ;;
    -*) die "unknown option $option" ;;
    *) break ;;
  esac
  shift
done
(($#)) || die "no command to run"
[[ -z ${fake_tiocsti:-} ]] || ((print)) || die "--tiocsti-sysctl only applies with --print-argv"

home=${HOME:?}
[[ $home == /* ]] || die "HOME must be absolute"
real_home=$(realpath -- "$home" 2>/dev/null) || real_home=$home

# Like GNU `realpath -m`, which macOS lacks: resolves the longest existing ancestor of
# an absolute path and appends the rest, so a symlinked parent cannot hide an entry.
resolve() {
  local path=$1 rest=
  while [[ ! -e $path ]]; do
    rest=/${path##*/}$rest
    path=${path%/*}
    path=${path:-/}
  done
  path=$(realpath -- "$path")
  printf '%s\n' "${path%/}$rest"
}

# Never writable, nor any directory holding one: credentials, babysit's own state and
# launchers, toolchains that also run outside, herdr's socket (which drives unsandboxed
# panes), the agent homes (each binds only as its own --claude-config-dir or
# --codex-home, below), and shell, session, service and git startup files, all of
# which run or authorize code outside.
protected=()
for path in .ssh .gnupg .config/gh .config/babysit-pr .local/state/babysit-pr .local/bin \
  .local/share/babysit-pr \
  .local/share/uv .local/share/claude .nvm .npm-global .docker .config/herdr .claude .codex \
  .cache/babysit-sandbox .bashrc .bashrc.d .bash_aliases .bash_profile .bash_login \
  .bash_logout .profile .inputrc .zshenv .zprofile .zshrc .zlogin .zlogout .config/fish \
  .tmux.conf .config/tmux .pam_environment .config/systemd .local/share/systemd \
  .local/share/dbus-1 .config/autostart .config/environment.d .gitconfig .config/git; do
  # A dotfile manager's link protects its target too.
  protected+=("$real_home/$path" "$(resolve "$home/$path")")
  if [[ -L $home/$path && ! -e $home/$path ]]; then
    # A dangling link: whoever creates its target writes this file.
    target=$(readlink -- "$home/$path")
    [[ $target == /* ]] || target=$(dirname -- "$home/$path")/$target
    protected+=("$(resolve "$target")")
  fi
done

# This launcher's own directory and, when that is a checkout's scripts/, the checkout
# and its git common directory: an agent writing either would change what the next
# launch runs. The common directory comes from the .git layout, without running git
# in it. Agents therefore never work in clones of the deployed copy, only in others.
self=$(realpath -- "${BASH_SOURCE[0]}")
protected+=("${self%/*}")
deployed=${self%/*/*}
if [[ ${self%/*} != */scripts ]]; then
  : # installed elsewhere: only its own directory
elif [[ -d $deployed/.git ]]; then
  protected+=("$deployed" "$(resolve "$deployed/.git")")
elif [[ -f $deployed/.git ]]; then
  read -r gitdir <"$deployed/.git" || true
  gitdir=${gitdir#gitdir: }
  [[ $gitdir == /* ]] || gitdir=$deployed/$gitdir
  common=$gitdir
  if [[ -f $gitdir/commondir ]]; then
    read -r common <"$gitdir/commondir" || true
    [[ $common == /* ]] || common=$gitdir/$common
  fi
  protected+=("$deployed" "$(resolve "$gitdir")" "$(resolve "$common")")
fi

# Binding by descriptor needs bwrap 0.10.0's --bind-fd; a dry run without bwrap binds paths.
bind_fd=0
if command -v bwrap >/dev/null; then
  help=$(bwrap --help 2>&1) || true
  [[ $help != *--bind-fd* ]] || bind_fd=1
fi

# Prints the resolved writable directory, nothing for one that does not exist (like
# --bind-try), and refuses anything that would expose what it must not. An agent
# configuration names its harness's home, $2: the directory itself, or for Claude one
# of its named accounts, is allowed there.
writable() {
  local path=$1 own=${2:-} real guard linked=
  [[ $path == /* ]] || die "refusing relative path $path"
  [[ -d $path ]] || return 0
  real=$(realpath -- "$path")
  if [[ $real == / || $real_home == "$real" || $real_home == "$real"/* ]]; then
    die "refusing $path, which would expose the home directory"
  fi
  [[ -z $own ]] || linked=$(resolve "$home/$own")
  for guard in "${protected[@]}"; do
    if [[ -n $own && ($guard == "$real_home/$own" || $guard == "$linked") ]]; then
      [[ $real == "$guard" ]] && continue
      [[ $own == .claude && $real == "$guard"/accounts/* && $real != "$guard"/accounts/*/* ]] &&
        continue
    fi
    if [[ $real == "$guard" || $real == "$guard"/* || $guard == "$real"/* ]]; then
      die "refusing $path, which overlaps the protected $guard"
    fi
  done
  printf '%s\n' "$real"
}

# Adds a writable bind of resolved directory $1, or a read-only one of resolved file or
# directory $1 with $2=ro-. By descriptor when bwrap can: the open follows whatever the
# path is now, so the descriptor must still name $1 itself, and bwrap then mounts that
# directory whatever happens to the path. The descriptor stays open into bwrap, which
# closes it after mounting.
grant() {
  local real=$1 kind=${2:-} fd now
  if ((bind_fd)); then
    exec {fd}<"$real" || die "cannot open $real"
    if [[ -d /proc/self/fd ]]; then
      now=$(readlink "/proc/self/fd/$fd") || now=
    elif ((print)); then
      now=$real # a dry run off Linux, which has no /proc to ask
    fi
    [[ ${now:-} == "$real" ]] || die "refusing $real, which changed while it was checked"
    argv+=("--${kind}bind-fd" "$fd" "$real")
  else
    argv+=("--${kind}bind" "$real" "$real")
  fi
}

# setsid stops the agent pushing input into the terminal (TIOCSTI), but an interactive
# agent needs its terminal's job control: drop it only when the kernel disables TIOCSTI.
session=(--new-session)
if [[ -t 0 ]] && read -r legacy 2>/dev/null <"$tiocsti" && [[ $legacy == 0 ]]; then
  session=()
fi
argv=(bwrap --die-with-parent ${session[@]+"${session[@]}"} --unshare-pid --unshare-ipc
  --unshare-uts --clearenv --proc /proc --dev /dev --tmpfs /tmp --tmpfs "$home")

if [[ -n $config_var ]]; then
  own=.claude
  [[ $config_var == CLAUDE_CONFIG_DIR ]] || own=.codex
  real=$(writable "$config_dir" "$own")
  # Exporting a missing one would point the agent at the empty home's tmpfs.
  [[ -n $real ]] || die "the agent configuration directory $config_dir does not exist"
  config_dir=$real
fi
# The grants that reach beyond the sandbox, in a fixed order.
granted=
((!docker)) || granted+=,docker
((!gpg)) || granted+=,gpg
granted=${granted#,}
# Everything below must keep a launch without these grants from leaving code for a
# launch with them, of any agent of the same configuration, to run.
command=("$@")
if [[ -n $granted && $config_var == CLAUDE_CONFIG_DIR ]]; then
  # Claude rewrites .claude.json all the time, so it stays writable, and the MCP servers
  # any agent of the account adds there start with Claude: a granted Claude starts none.
  [[ ${1##*/} == claude ]] || die "refusing --enable=$granted for $1 with a Claude configuration; run claude itself"
  command=("$1" --strict-mcp-config "${@:2}")
fi
# Package caches for sandboxed agents only: nothing outside the sandbox runs code from
# them, unlike the host caches an agent could otherwise plant code in. One per agent
# configuration and set of grants, so an agent never runs downloads that one with
# fewer grants could have replaced.
sha=(sha256sum)
command -v sha256sum >/dev/null || sha=(shasum -a 256) # macOS dry runs
key=$(printf '%s\0%s\0%s' "$config_var" "$config_dir" "$granted" | "${sha[@]}")
cache=$home/.cache/babysit-sandbox/${key:0:16}

# Writable: the sandbox cache, the agent configuration and the explicit grants. They
# come before every read-only bind, so none of them can shadow one.
argv+=(--bind "$cache" "$cache")
[[ -z $config_var ]] || grant "$config_dir"
for path in ${add_dirs[@]+"${add_dirs[@]}"}; do
  [[ -n $path ]] || continue
  real=$(writable "$path")
  [[ -n $real ]] || continue
  # A grant holding the configuration could move it, read-only entries and all.
  if [[ -n $config_var ]] &&
    [[ $real == "$config_dir" || $config_dir == "$real"/* || $real == "$config_dir"/* ]]; then
    die "refusing $path, which overlaps the agent configuration $config_dir"
  fi
  grant "$real"
done
if [[ $config_var == CLAUDE_CONFIG_DIR ]]; then
  # The default account's directory holds the named accounts: hide them, always, or its
  # agent could create accounts as a link that a later account launch resolves through.
  if [[ $config_dir == "$real_home/.claude" || $config_dir == "$(resolve "$home/.claude")" ]]; then
    [[ ! -L $config_dir/accounts ]] || die "refusing $config_dir/accounts, a link"
    argv+=(--tmpfs "$config_dir/accounts")
  fi
  # Claude sources its shell snapshot before every Bash command: one per sandbox.
  argv+=(--tmpfs "$config_dir/shell-snapshots")
elif [[ $config_var == CODEX_HOME ]]; then
  argv+=(--tmpfs "$config_dir/shell_snapshots")
fi

if ((gpg)); then
  # Signing through this user's gpg-agent, and nothing else of ~/.gnupg (protected, so
  # never bound): a throwaway home on the sandbox's tmpfs holding copies of the public
  # keyring and trust database and a gpg.conf that never starts an agent inside, plus,
  # at the agent's standard socket path, a proxy for this launch that passes on only
  # what signing needs (gpg_agent_proxy.py). Private keys, any passphrase file and the
  # agent's own configuration stay outside; the sandbox can have the unlocked key sign
  # anything, but cannot export it, read or clear passphrases, delete keys, stop the
  # agent or aim a pinentry at a terminal. Copies, so gpg may lock and update them
  # without touching the originals.
  command -v gpgconf >/dev/null || die "gpgconf is not installed"
  gnupghome=$home/.gnupg
  # The default home's socket, whatever GNUPGHOME the caller passes: the sandbox uses
  # that same home path, so gpg there derives this same socket path.
  socket=$(env -u GNUPGHOME gpgconf --list-dirs agent-socket) || die "gpgconf cannot name the gpg-agent socket"
  [[ $socket == /* ]] || die "refusing the relative gpg-agent socket $socket"
  [[ -S $socket ]] || die "no gpg-agent socket at $socket"
  [[ -O $socket ]] || die "refusing $socket, which belongs to another user"
  [[ -f $gnupghome/pubring.kbx ]] || die "no public keyring at $gnupghome/pubring.kbx"
  exec {gpg_conf}<<<$'no-autostart\nuse-agent' || die "cannot write gpg.conf"
  exec {pubring}<"$gnupghome/pubring.kbx" || die "cannot open $gnupghome/pubring.kbx"
  argv+=(--perms 0700 --dir "$gnupghome" --perms 0600 --file "$gpg_conf" "$gnupghome/gpg.conf"
    --perms 0600 --file "$pubring" "$gnupghome/pubring.kbx")
  if [[ -f $gnupghome/trustdb.gpg ]]; then
    exec {trustdb}<"$gnupghome/trustdb.gpg" || die "cannot open $gnupghome/trustdb.gpg"
    argv+=(--perms 0600 --file "$trustdb" "$gnupghome/trustdb.gpg")
  fi
  # The proxy lives in a private directory of its own, outside every sandbox, and exits
  # with bwrap (which this script becomes), removing it.
  if ((print)); then
    proxy=$(mktemp -d -u "${XDG_RUNTIME_DIR:-/tmp}/babysit-gpg.XXXXXX")
  else
    command -v python3 >/dev/null || die "python3 is not installed"
    proxy=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/babysit-gpg.XXXXXX") || die "cannot create a gpg-agent proxy directory"
    exec {ready}< <(exec python3 -I "${self%/*}/gpg_agent_proxy.py" "$proxy/S.gpg-agent" "$socket" </dev/null)
    if ! read -r -u "$ready" line || [[ $line != ready ]]; then
      rmdir "$proxy" 2>/dev/null || true
      die "the gpg-agent proxy did not start"
    fi
    exec {ready}<&-
  fi
  # gpg uses /run/user/<uid>/gnupg only while it and its parent are private to the user,
  # else it looks in the home. A socket cannot be opened, so it is bound by path: it
  # lives in a private directory, which no sandbox can write.
  socket_dir=$(dirname -- "$socket")
  argv+=(--perms 0700 --dir "$(dirname -- "$socket_dir")" --perms 0700 --dir "$socket_dir"
    --bind "$proxy/S.gpg-agent" "$socket")
fi

if ((docker)); then
  # The system daemon's socket is root on this machine and is always refused. A rootless
  # daemon still gives up the filesystem boundary: `docker run -v $HOME:/h` reaches every
  # file of this user. Enabling Docker trusts the agent with them.
  socket="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/docker.sock"
  real=$(readlink -f "$socket" 2>/dev/null) || real=$socket
  for path in "$socket" "$real"; do
    case $path in
      /var/run/docker.sock | /run/docker.sock | /private/var/run/docker.sock)
        die "refusing the system Docker socket $socket"
        ;;
    esac
  done
  [[ -S $socket ]] || die "no rootless Docker socket at $socket"
  [[ -O $socket ]] || die "refusing $socket, which belongs to another user"
  argv+=(--bind "$socket" "$socket" --setenv DOCKER_HOST "unix://$socket")
fi

# What the agent runs from its configuration, read-only on top of its writable bind in
# every launch: settings and hooks, plugins, skills, commands, agents and instructions.
# Missing ones become empty placeholders first, or an agent could create them for the
# next launch to load; a link is refused, since binding it would follow it outside.
if [[ -n $config_var ]]; then
  if [[ $config_var == CLAUDE_CONFIG_DIR ]]; then
    code=(settings.json CLAUDE.md agents commands hooks output-styles plugins rules session-env
      skills workflows)
  else
    code=(config.toml hooks.json AGENTS.md AGENTS.override.md packages plugins prompts rules
      skills)
  fi
  for name in "${code[@]}"; do
    path=$config_dir/$name
    if ((!print)) && [[ ! -e $path && ! -L $path ]]; then
      # Without following or replacing anything another sandbox creates meanwhile:
      # mkdir and a hard link from a fresh file both fail on any existing name.
      if [[ $name == *.* ]]; then
        placeholder=$(mktemp "$config_dir/.babysit-placeholder.XXXXXX") || die "cannot create $path"
        [[ $name != *.json ]] || printf '{}\n' >>"$placeholder"
        ln "$placeholder" "$path" 2>/dev/null || true
        rm -f "$placeholder"
      else
        mkdir -m 0700 "$path" 2>/dev/null || true
      fi
    fi
    if [[ -L $path ]]; then
      die "refusing $path, a link; make it a file or directory of its own"
    elif [[ -f $path || -d $path ]]; then
      grant "$path" ro-
    elif [[ -e $path ]]; then
      die "refusing $path, which is neither a file nor a directory"
    else
      ((print)) || die "cannot create $path"
      argv+=(--ro-bind "$path" "$path")
    fi
  done
fi

# Read-only system. Merged-/usr links stay links.
for path in /usr /bin /sbin /lib /lib32 /lib64 /libx32 /opt; do
  if [[ -L $path ]]; then
    argv+=(--symlink "$(readlink "$path")" "$path")
  else
    argv+=(--ro-bind-try "$path" "$path")
  fi
done
for path in alternatives ca-certificates crypto-policies gai.conf gitconfig group host.conf \
  hosts ld.so.cache ld.so.conf ld.so.conf.d localtime nsswitch.conf os-release passwd pki \
  resolv.conf ssl; do
  argv+=(--ro-bind-try "/etc/$path" "/etc/$path")
done

# Toolchains and credentials, read-only. gh holds the only GitHub credential.
for path in .local/bin .local/share/uv .local/share/claude .nvm .npm-global .gitconfig \
  .config/git .config/gh; do
  argv+=(--ro-bind-try "$home/$path" "$home/$path")
done

for name in PATH HOME TERM LANG USER ${env_pass[@]+"${env_pass[@]}"}; do
  [[ $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "invalid variable name $name"
  if [[ -n ${!name+set} ]]; then
    argv+=(--setenv "$name" "${!name}")
  fi
done
# Last, so no --env-pass name can point an agent at host caches or another configuration.
argv+=(--setenv XDG_CACHE_HOME "$cache" --setenv UV_CACHE_DIR "$cache/uv"
  --setenv PIP_CACHE_DIR "$cache/pip" --setenv npm_config_cache "$cache/npm"
  --setenv PLAYWRIGHT_BROWSERS_PATH "$cache/ms-playwright")
[[ -z $config_var ]] || argv+=(--setenv "$config_var" "$config_dir")
((!gpg)) || argv+=(--setenv GNUPGHOME "$gnupghome")
# Inside, $HOME is empty: a worker's agent learns it is on one from this, set last so
# no --env-pass value can clear it, and pr_supervisor refuses to register watches there.
[[ ! -e $home/.config/babysit-pr/worker.json ]] || argv+=(--setenv BABYSIT_WORKER 1)

argv+=(--chdir "$(pwd -P)" -- "${command[@]}")
if ((print)); then
  printf '%s\0' "${argv[@]}"
  exit 0
fi
command -v bwrap >/dev/null || die "bubblewrap (bwrap) is not installed"
mkdir -p "$cache"
exec "${argv[@]}"

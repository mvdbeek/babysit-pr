#!/usr/bin/env bash
# Linux agent sandbox: bubblewrap behind Agent Safehouse's grant options.
#
#   babysit-bwrap [--add-dirs=A:B] [--claude-config-dir=D | --codex-home=D]
#                 [--env-pass=X,Y] [--enable=docker,playwright] [--print-argv] [--] command...
#
# Deny by default: a read-only system, an empty $HOME, and writes only to --add-dirs (the
# caller passes the worktree and its git common directory there), the one agent
# configuration directory (which must exist) and a cache root that only sandboxed agents
# of that configuration use. Nothing is
# discovered from the working directory or its git files, which the agent can rewrite.
# Every writable path must be absolute and is resolved first; home, its ancestors and
# protected paths are refused. The environment is cleared except for a small baseline,
# the agent configuration variable, the cache variables and the --env-pass names that
# are set. The network is shared. Where bwrap has --bind-fd (0.10.0 and later), each
# writable directory is opened once, checked through its descriptor and bound by it, so
# a path swapped after the check cannot redirect the bind. --print-argv prints the bwrap
# argv, NUL-separated, instead of running it. Needs bash 4.1 or later (`exec {fd}<`).
set -euo pipefail

die() {
  printf 'babysit-bwrap: %s\n' "$*" >&2
  exit 2
}

add_dirs=()
env_pass=()
config_var=
config_dir=
docker=0
print=0
tiocsti=/proc/sys/dev/tty/legacy_tiocsti
while (($#)); do
  option=$1
  case $option in
    --add-dirs | --env-pass | --enable | --claude-config-dir | --codex-home)
      (($# > 1)) || die "$option needs a value"
      shift
      option="$option=$1"
      ;;
  esac
  # `read` stops at a newline, which would silently drop the rest of a list.
  [[ $option != *$'\n'* ]] || die "refusing an option containing a newline"
  case $option in
    --add-dirs=*) IFS=: read -r -a more <<<"${option#*=}" && add_dirs+=(${more[@]+"${more[@]}"}) ;;
    --env-pass=*) IFS=, read -r -a more <<<"${option#*=}" && env_pass+=(${more[@]+"${more[@]}"}) ;;
    --claude-config-dir=* | --codex-home=*)
      [[ -z $config_var ]] || die "only one agent configuration directory is allowed"
      config_var=CLAUDE_CONFIG_DIR
      [[ $option == --claude-config-dir=* ]] || config_var=CODEX_HOME
      config_dir=${option#*=}
      ;;
    --enable=*)
      IFS=, read -r -a more <<<"${option#*=}"
      for feature in ${more[@]+"${more[@]}"}; do
        case $feature in
          docker) docker=1 ;;
          # Accepted like Safehouse's playwright-chrome: Chromium needs nothing beyond
          # the always-present /dev/shm and the sandbox's own browser cache.
          playwright | playwright-chrome) ;;
          *) die "unknown feature $feature" ;;
        esac
      done
      ;;
    --print-argv) print=1 ;;
    # Test hook for the TIOCSTI check below; honoured only by a dry run.
    --tiocsti-sysctl=*) tiocsti=${option#*=} && fake_tiocsti=1 ;;
    --)
      shift
      break
      ;;
    -*) die "unknown option $option" ;;
    *) break ;;
  esac
  shift
done
(($#)) || die "no command to run"
[[ -z ${fake_tiocsti:-} ]] || ((print)) || die "--tiocsti-sysctl only applies with --print-argv"

home=${HOME:?}
[[ $home == /* ]] || die "HOME must be absolute"
real_home=$(realpath -- "$home" 2>/dev/null) || real_home=$home

# Like GNU `realpath -m`, which macOS lacks: resolves the longest existing ancestor of
# an absolute path and appends the rest, so a symlinked parent cannot hide an entry.
resolve() {
  local path=$1 rest=
  while [[ ! -e $path ]]; do
    rest=/${path##*/}$rest
    path=${path%/*}
    path=${path:-/}
  done
  path=$(realpath -- "$path")
  printf '%s\n' "${path%/}$rest"
}

# Never writable, nor any directory holding one: credentials, babysit's own state and
# launchers, and shell, session and git startup files, all of which run or authorize
# code outside.
protected=()
for path in .ssh .gnupg .config/gh .config/babysit-pr .local/state/babysit-pr .local/bin \
  .cache/babysit-sandbox .bashrc .bashrc.d .bash_profile .bash_login .bash_logout .profile \
  .zshenv .zprofile .zshrc .zlogin .zlogout .config/fish .pam_environment .config/systemd \
  .config/autostart .config/environment.d .gitconfig .config/git; do
  # A dotfile manager's link protects its target too.
  protected+=("$real_home/$path" "$(resolve "$home/$path")")
  if [[ -L $home/$path && ! -e $home/$path ]]; then
    # A dangling link: whoever creates its target writes this file.
    target=$(readlink -- "$home/$path")
    [[ $target == /* ]] || target=$(dirname -- "$home/$path")/$target
    protected+=("$(resolve "$target")")
  fi
done

# Binding by descriptor needs bwrap 0.10.0's --bind-fd; a dry run without bwrap binds paths.
bind_fd=0
if command -v bwrap >/dev/null; then
  help=$(bwrap --help 2>&1) || true
  [[ $help != *--bind-fd* ]] || bind_fd=1
fi

# Prints the resolved writable directory, nothing for one that does not exist (like
# --bind-try), and refuses anything that would expose what it must not.
writable() {
  local path=$1 real guard
  [[ $path == /* ]] || die "refusing relative path $path"
  [[ -d $path ]] || return 0
  real=$(realpath -- "$path")
  if [[ $real == / || $real_home == "$real" || $real_home == "$real"/* ]]; then
    die "refusing $path, which would expose the home directory"
  fi
  for guard in "${protected[@]}"; do
    if [[ $real == "$guard" || $real == "$guard"/* || $guard == "$real"/* ]]; then
      die "refusing $path, which overlaps the protected $guard"
    fi
  done
  printf '%s\n' "$real"
}

# Adds a writable bind of resolved directory $1. By descriptor when bwrap can: the open
# follows whatever the path is now, so the descriptor must still name $1 itself, and
# bwrap then mounts that directory whatever happens to the path. The descriptor stays
# open into bwrap, which closes it after mounting.
grant() {
  local real=$1 fd now
  if ((bind_fd)); then
    exec {fd}<"$real" || die "cannot open $real"
    if [[ -d /proc/self/fd ]]; then
      now=$(readlink "/proc/self/fd/$fd") || now=
    elif ((print)); then
      now=$real # a dry run off Linux, which has no /proc to ask
    fi
    [[ ${now:-} == "$real" ]] || die "refusing $real, which changed while it was checked"
    argv+=(--bind-fd "$fd" "$real")
  else
    argv+=(--bind "$real" "$real")
  fi
}

# setsid stops the agent pushing input into the terminal (TIOCSTI), but an interactive
# agent needs its terminal's job control: drop it only when the kernel disables TIOCSTI.
session=(--new-session)
if [[ -t 0 ]] && read -r legacy 2>/dev/null <"$tiocsti" && [[ $legacy == 0 ]]; then
  session=()
fi
argv=(bwrap --die-with-parent ${session[@]+"${session[@]}"} --unshare-pid --unshare-ipc
  --unshare-uts --clearenv --proc /proc --dev /dev --tmpfs /tmp --tmpfs "$home")

if [[ -n $config_var ]]; then
  real=$(writable "$config_dir")
  # Exporting a missing one would point the agent at the empty home's tmpfs.
  [[ -n $real ]] || die "the agent configuration directory $config_dir does not exist"
  config_dir=$real
fi
# Package caches for sandboxed agents only: nothing outside the sandbox runs code from
# them, unlike the host caches an agent could otherwise plant code in. One per agent
# configuration, so agents with different grants never run each other's downloads.
sha=(sha256sum)
command -v sha256sum >/dev/null || sha=(shasum -a 256) # macOS dry runs
key=$(printf '%s=%s' "$config_var" "$config_dir" | "${sha[@]}")
cache=$home/.cache/babysit-sandbox/${key:0:16}

# Writable: the sandbox cache, the agent configuration and the explicit grants. They
# come before every read-only bind, so none of them can shadow one.
argv+=(--bind "$cache" "$cache")
[[ -z $config_var ]] || grant "$config_dir"
for path in ${add_dirs[@]+"${add_dirs[@]}"}; do
  [[ -n $path ]] || continue
  real=$(writable "$path")
  [[ -z $real ]] || grant "$real"
done

if ((docker)); then
  # The system daemon's socket is root on this machine and is always refused. A rootless
  # daemon still gives up the filesystem boundary: `docker run -v $HOME:/h` reaches every
  # file of this user. Enabling Docker trusts the agent with them.
  socket="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/docker.sock"
  real=$(readlink -f "$socket" 2>/dev/null) || real=$socket
  for path in "$socket" "$real"; do
    case $path in
      /var/run/docker.sock | /run/docker.sock | /private/var/run/docker.sock)
        die "refusing the system Docker socket $socket"
        ;;
    esac
  done
  [[ -S $socket ]] || die "no rootless Docker socket at $socket"
  [[ -O $socket ]] || die "refusing $socket, which belongs to another user"
  argv+=(--bind "$socket" "$socket" --setenv DOCKER_HOST "unix://$socket")
fi

# Read-only system. Merged-/usr links stay links.
for path in /usr /bin /sbin /lib /lib32 /lib64 /libx32 /opt; do
  if [[ -L $path ]]; then
    argv+=(--symlink "$(readlink "$path")" "$path")
  else
    argv+=(--ro-bind-try "$path" "$path")
  fi
done
for path in alternatives ca-certificates crypto-policies gai.conf gitconfig group host.conf \
  hosts ld.so.cache ld.so.conf ld.so.conf.d localtime nsswitch.conf os-release passwd pki \
  resolv.conf ssl; do
  argv+=(--ro-bind-try "/etc/$path" "/etc/$path")
done

# Toolchains and credentials, read-only. gh holds the only GitHub credential.
for path in .local/bin .local/share/uv .local/share/claude .nvm .npm-global .gitconfig \
  .config/git .config/gh; do
  argv+=(--ro-bind-try "$home/$path" "$home/$path")
done

for name in PATH HOME TERM LANG USER ${env_pass[@]+"${env_pass[@]}"}; do
  [[ $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "invalid variable name $name"
  if [[ -n ${!name+set} ]]; then
    argv+=(--setenv "$name" "${!name}")
  fi
done
# Last, so no --env-pass name can point an agent at host caches or another configuration.
argv+=(--setenv XDG_CACHE_HOME "$cache" --setenv UV_CACHE_DIR "$cache/uv"
  --setenv PIP_CACHE_DIR "$cache/pip" --setenv npm_config_cache "$cache/npm"
  --setenv PLAYWRIGHT_BROWSERS_PATH "$cache/ms-playwright")
[[ -z $config_var ]] || argv+=(--setenv "$config_var" "$config_dir")

argv+=(--chdir "$(pwd -P)" -- "$@")
if ((print)); then
  printf '%s\0' "${argv[@]}"
  exit 0
fi
command -v bwrap >/dev/null || die "bubblewrap (bwrap) is not installed"
mkdir -p "$cache"
exec "${argv[@]}"

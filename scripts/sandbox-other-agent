#!/bin/sh
# A diagnostic on babysit-bwrap's PATH, bound read-only under the other CLI's name.
# This is guidance, not an authorization check: explicit executable paths still run
# with the same isolated HOME. The broker/controller enforce sub-task authorization.
case ${0##*/} in
  claude) selected=Codex; requested=Claude; option='--claude --claude-account <account|default>' ;;
  codex) selected=Claude; requested=Codex; option=--codex ;;
  *) printf '%s\n' 'Invoke this diagnostic as claude or codex.' >&2; exit 2 ;;
esac
printf '%s\n' \
  "babysit-bwrap: this $selected sandbox has no $requested account mounted." \
  'Its HOME and agent configuration are isolated; re-login on the host will not change this namespace.' \
  'Direct executable paths may run, but do not gain the other provider account. wt is the supported controller approval route.' \
  "For an explicitly requested cross-agent review, request wt --review $option -r OWNER/REPO -F BRIEF FULL_COMMIT_SHA REVIEW_BRANCH. Approve the exact request in the dashboard Scheduled tab with a signed-in session; no reviewer starts before approval." \
  'Select the intended account on the reviewer worker. The executable and authenticated account must be available there. Share the exact commit/diff through the repository or an explicitly granted path; private account caches are separate.' >&2
exit 2
